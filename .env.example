# Public-shell development only. Protected APIs fail closed until services are enabled.
APP_ENV=development
APP_URL=http://127.0.0.1:3000
SERVICES_ENABLED=false
AUTH_PROVIDER=supabase
DATABASE_PROVIDER=postgres
STORAGE_PROVIDER=supabase
# Optional hybrid Azure Blob profile; see docs/azure-storage.md.
# Set STORAGE_PROVIDER=azure and supply both account settings to select it.
# AZURE_STORAGE_ACCOUNT_NAME=syntheticnova
# AZURE_STORAGE_ACCOUNT_RESOURCE_ID=/subscriptions/<uuid>/resourceGroups/<group>/providers/Microsoft.Storage/storageAccounts/<account>
AZURE_CREDENTIAL_MODE=managed_identity
# Optional user-assigned managed identity client ID; omit for system-assigned identity.
# AZURE_CLIENT_ID=<uuid>
AZURE_STORAGE_TIMEOUT_MS=10000
EMAIL_PROVIDER=smtp
AI_PROVIDER=disabled
RATE_LIMIT_PROVIDER=postgres
OBSERVABILITY_PROVIDER=console
# local: dev HTTP loop; external: authenticated HTTP job; database: owner-installed pg_cron SQL job
SCHEDULER_PROVIDER=local
SECRETS_PROVIDER=env
# Optional server-side Key Vault resolution: SECRETS_PROVIDER=azure_key_vault.
# Map only allowlisted secret settings to explicit name/version references.
# AZURE_KEY_VAULT_URL=https://<vault-name>.vault.azure.net
# AZURE_KEY_VAULT_SECRET_MAP={"DATABASE_URL":"nova-database-url/00000000000000000000000000000000","SUPABASE_SERVICE_ROLE_KEY":"nova-service-role/00000000000000000000000000000000"}
AZURE_KEY_VAULT_TIMEOUT_MS=10000
# In Key Vault mode leave all secret values below unset; add any needed SMTP,
# OpenAI, contact HMAC and scheduler secrets to the map. No environment fallback.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Verified TLS is default. Plaintext requires an explicit development/test local host.
DATABASE_TLS_MODE=verify_full
# Optional public CA PEM bundle (actual newlines); never a private key or file path.
DATABASE_CA_CERT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Development/test Docker Mailpit only; rejected with remote hosts/auth credentials.
SMTP_ALLOW_INSECURE_LOCAL=false
EMAIL_FROM=
SUPPORT_EMAIL=
# Explicitly enable contact only with a private HMAC key and trusted hosted ingress.
CONTACT_ENABLED=false
CONTACT_HASH_SECRET=
CONTACT_CLIENT_IP_HEADER=none
OPENAI_API_KEY=
OPENAI_MODEL=
# Optional independent Azure AI profile: AI_PROVIDER=azure.
# Requires an existing deployment supporting Responses v1 and strict Structured Outputs.
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
# Uses the shared AZURE_CREDENTIAL_MODE / optional AZURE_CLIENT_ID above.
SUPPORT_AI_TIMEOUT_MS=8000
SUPPORT_AI_MAX_OUTPUT_TOKENS=256
SUPPORT_AI_DAILY_REQUEST_LIMIT=1000
OFFER_IMAGE_BUCKET=offer-images
OFFER_IMAGE_MAX_BYTES=5242880
IMAGE_PROCESSING_TIMEOUT_MS=5000
REPORT_BUCKET=client-reports
UPLOAD_MAX_BYTES=5242880
DOWNLOAD_TTL_SECONDS=60
# Required for external scheduling and local maintenance:watch; server-only, 32–256 characters.
CRON_SECRET=
# Scheduled completion age in seconds; align with the hosted cadence (60–86400).
MAINTENANCE_STALE_AFTER_SECONDS=2700

MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
SCAN_TIMEOUT_MS=10000
PDF_VALIDATION_TIMEOUT_MS=3000
MAX_REPORT_PAGES=1000
REPORT_TIME_ZONE=Asia/Kolkata

# Optional Entra profile: AUTH_PROVIDER=entra. Apply all migrations first.
# Services-enabled Entra requires a canonical HTTPS APP_URL and every field below.
# Prefer a separate directory application with reviewed Graph application permissions.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_TENANT_SUBDOMAIN=
ENTRA_CLIENT_SECRET=
ENTRA_MFA_ISSUER=
ENTRA_MFA_ACTIVE_KEY_ID=
# JSON mapping of 1-3 key IDs to independently generated 32-byte base64url keys.
# Retain previous keys during controlled rotation; never copy CI canary material.
ENTRA_MFA_ENCRYPTION_KEYS=
ENTRA_DIRECTORY_CLIENT_ID=
ENTRA_DIRECTORY_CLIENT_SECRET=
ENTRA_RECOVERY_MODE=
ENTRA_DIRECTORY_TIMEOUT_MS=10000
ENTRA_DISCOVERY_TIMEOUT_MS=5000
ENTRA_EXCHANGE_TIMEOUT_MS=10000
# Set ENTRA_RECOVERY_MODE=hosted_sspr only for the reviewed tenant flow.
# The three Entra secret settings are also allowlisted for pinned Key Vault references.

# Optional operational trace export. Console remains the default.
# OBSERVABILITY_PROVIDER=azure_monitor
# Exact two-field public Azure regional connection string, server-only / Key Vault.
AZURE_MONITOR_CONNECTION_STRING=
# Required for azure_monitor: disables the pinned SDK's independent Statsbeat traffic.
# APPLICATION_INSIGHTS_NO_STATSBEAT=true
# Queue is memory-only and bounded; export failures do not block application requests.

# Azure Monitor always uses Entra-authenticated ingestion through AZURE_CREDENTIAL_MODE.
# Hosted: managed_identity; optional AZURE_CLIENT_ID selects a user-assigned identity.
# Grant that identity Monitoring Metrics Publisher on the exact Application Insights resource.
# Verify local-authentication policy and token/ingestion acceptance separately in staging.

# Education stores consented requests in the private admin inbox, independently of email.
# Requires SERVICES_ENABLED, CONTACT_HASH_SECRET and trusted ingress in staging/production.
EDUCATION_ENABLED=false
