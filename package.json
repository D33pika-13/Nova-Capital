{
  "name": "nova-capital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.3 <25"
  },
  "scripts": {
    "dev": "node scripts/check-runtime.mjs && next dev --hostname 127.0.0.1",
    "build": "node scripts/check-runtime.mjs && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm check:pdf-package && pnpm check:image-package && pnpm check:startup-package && pnpm check:shutdown-package && pnpm check:secrets",
    "check:secrets": "node scripts/check-browser-secrets.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"scripts/*.mjs\" \"*.ts\" \"*.mjs\" \"*.json\" .github/workflows/ci.yml \"compose*.yaml\"",
    "check:pdf-package": "node scripts/check-pdf-package.mjs",
    "maintenance": "node scripts/run-maintenance.mjs",
    "maintenance:watch": "node --env-file=.env.local scripts/run-maintenance.mjs --watch",
    "check:image-package": "node scripts/check-image-package.mjs",
    "check:startup-package": "node scripts/check-startup-package.mjs",
    "check:infra": "node scripts/check-infra.mjs",
    "check:container": "node scripts/check-container.mjs",
    "check:compose": "node scripts/check-compose.mjs",
    "check:native-database": "node scripts/check-native-database.mjs",
    "check:shutdown-package": "node scripts/check-shutdown-package.mjs",
    "check:load-native": "node scripts/check-native-database.mjs --load",
    "check:scanner-native": "node scripts/check-native-scanner.mjs",
    "check:ingress": "node scripts/check-ingress.mjs"
  },
  "dependencies": {
    "@azure/core-rest-pipeline": "1.25.1",
    "@azure/identity": "4.14.1",
    "@azure/monitor-opentelemetry-exporter": "1.0.0-beta.32",
    "@azure/storage-blob": "12.34.0",
    "@hookform/resolvers": "5.9.2",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/resources": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "jose": "6.2.17",
    "lucide-react": "1.70.0",
    "next": "16.4.6",
    "nodemailer": "10.5.0",
    "oauth4webapi": "3.8.8",
    "otplib": "13.6.0",
    "pdf-lib": "1.17.1",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.16",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/smtp-server": "3.5.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "prettier": "3.9.10",
    "smtp-server": "3.21.3",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "type": "module"
}
