# Synthetic LOCAL integration only. Copy to ignored .env.integration and edit.
# Used only by the separate compose.database.yaml rehearsal.
NOVA_LOCAL_DB_PASSWORD=replace-with-a-unique-synthetic-owner-password
DATABASE_URL=postgresql://nova_app:replace-with-a-unique-synthetic-runtime-password@host.docker.internal:54322/postgres
DATABASE_TLS_MODE=disable
# Local Supabase CLI (on Docker Desktop host), or a dedicated synthetic test project.
SUPABASE_URL=http://host.docker.internal:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
EMAIL_FROM=sender@example.test
SUPPORT_EMAIL=support@example.test
STORAGE_PROVIDER=supabase
REPORT_BUCKET=client-reports
OFFER_IMAGE_BUCKET=offer-images
AI_PROVIDER=disabled
CONTACT_ENABLED=true
CONTACT_HASH_SECRET=replace-with-a-unique-local-hmac-key-at-least-32-characters
SCHEDULER_PROVIDER=local
CRON_SECRET=replace-with-a-unique-local-maintenance-key-at-least-32-characters
